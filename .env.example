# Copy this file to .env.local for local development. Real values live in
# Vercel > Project > Settings > Environment Variables, never in this repo.

# Public: safe in browser code, protected by Row Level Security
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET: server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
